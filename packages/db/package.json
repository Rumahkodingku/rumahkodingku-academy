{
  "name": "@rumahkodingku-academy/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:migrate": "tsx src/cli/run-migrations.ts",
    "db:revert": "tsx src/cli/revert-migration.ts",
    "db:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/data-source.ts",
    "db:seed:rbac": "tsx src/cli/run-seed-rbac.ts",
    "auth:create-admin": "tsx src/cli/run-create-admin.ts"
  },
  "dependencies": {
    "@nestjs/authentication": "^0.1.5",
    "@rumahkodingku-academy/env": "workspace:*",
    "dotenv": "catalog:",
    "mysql2": "^3.24.6",
    "reflect-metadata": "catalog:",
    "typeorm": "^1.1.2",
    "uuid": "^14.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rumahkodingku-academy/config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  }
}
