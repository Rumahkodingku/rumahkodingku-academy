    "@rumahkodingku-academy/env": "workspace:*",
    "dotenv": "catalog:",
    "express": "^5.3.0",
    "i18next": "catalog:",
    "ioredis": "^6.0.0",
    "posthog-node": "^5.69.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "catalog:",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "winston": "^3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@rumahkodingku-academy/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/express": "^5.0.6",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
