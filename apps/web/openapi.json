          },
          "400": { "description": "Bad Request" },
          "429": { "description": "Too Many Requests" }
        },
        "summary": "Resend a verification email",
        "tags": ["Authentication"]
      }
    },
    "/api/v1/users/me": {
      "get": {
        "operationId": "ProfileController_getMe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthUserEnvelopeResponseDto" }
              }
            }
          },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not Found" },
          "422": { "description": "Unprocessable Entity" },
          "429": { "description": "Too Many Requests" },
          "500": { "description": "Internal Server Error" }
        },
        "security": [{ "access_token": [] }],
        "summary": "Get the current profile",
        "tags": ["Profile"]
      },
      "patch": {
        "operationId": "ProfileController_updateMe",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UpdateProfileDto" } }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthUserEnvelopeResponseDto" }
              }
            }
          },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "409": { "description": "Conflict" },
          "422": { "description": "Unprocessable Entity" },
          "429": { "description": "Too Many Requests" }
        },
        "security": [{ "access_token": [] }],
        "summary": "Update the current profile",
        "tags": ["Profile"]
      }
    },
    "/api/v1/users/me/avatar": {
      "post": {
        "operationId": "ProfileController_uploadAvatar",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "JPEG, PNG, or WebP up to 2 MB",
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": { "file": { "type": "string", "format": "binary" } },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AvatarUploadEnvelopeResponseDto" }
              }
            }
          },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "413": { "description": "Payload Too Large" },
          "415": { "description": "Unsupported Media Type" },
          "422": { "description": "Unprocessable Entity" },
          "429": { "description": "Too Many Requests" }
        },
        "security": [{ "access_token": [] }],
        "summary": "Upload a private avatar",
        "tags": ["Profile"]
      },
      "get": {
        "operationId": "ProfileController_getAvatar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Avatar image",
            "content": { "image/*": { "schema": { "type": "string", "format": "binary" } } }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not Found" }
        },
        "security": [{ "access_token": [] }],
        "summary": "Get the current avatar",
        "tags": ["Profile"]
      },
      "delete": {
        "operationId": "ProfileController_deleteAvatar",
        "parameters": [],
        "responses": {
          "204": { "description": "Avatar deleted" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "429": { "description": "Too Many Requests" }
        },
        "security": [{ "access_token": [] }],
        "summary": "Delete the current avatar",
        "tags": ["Profile"]
      }
    }
  },
  "info": {
    "title": "Rumah Kodingku Academy API",
    "description": "REST API for Rumah Kodingku Academy",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": { "cookie": { "type": "apiKey", "in": "cookie", "name": "access_token" } },
    "schemas": {
      "CsrfTokenDataResponseDto": {
        "type": "object",
        "properties": { "csrfToken": { "type": "string", "example": "csrf-token-value" } },
        "required": ["csrfToken"]
      },
      "ApiMetaResponseDto": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string", "example": "01a1d278-95d7-72ba-aff9-93927d0f23c7" }
        },
        "required": ["requestId"]
      },
      "CsrfTokenEnvelopeResponseDto": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/CsrfTokenDataResponseDto" },
          "meta": { "$ref": "#/components/schemas/ApiMetaResponseDto" }
        },
        "required": ["data", "meta"]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "x-nestjs_zod-parent-additional-properties": false
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "x-nestjs_zod-parent-additional-properties": false
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "x-nestjs_zod-parent-additional-properties": false
          }
        },
        "required": ["name", "email", "password"]
      },
      "AuthUserProfileResponseDto": {
        "type": "object",
        "properties": {
          "displayName": { "type": "string", "example": "Nama Baru" },
          "fullName": { "type": "object", "nullable": true, "example": null },
          "username": { "type": "object", "nullable": true, "example": "phase_three" },
          "bio": { "type": "object", "nullable": true, "example": "Belajar backend" },
          "headline": { "type": "object", "nullable": true, "example": null },
          "avatarUrl": { "type": "object", "nullable": true, "example": "/api/v1/users/me/avatar" },
          "phone": { "type": "object", "nullable": true, "example": null },
          "countryCode": { "type": "object", "nullable": true, "example": "ID" },
          "city": { "type": "object", "nullable": true, "example": null },
          "timezone": { "type": "object", "nullable": true, "example": "Asia/Jakarta" },
          "locale": { "type": "string", "example": "id" },
          "websiteUrl": { "type": "object", "nullable": true, "example": null },
          "githubUrl": {
            "type": "object",
            "nullable": true,
            "example": "https://github.com/example"
          },
          "linkedinUrl": { "type": "object", "nullable": true, "example": null },
          "xUrl": { "type": "object", "nullable": true, "example": null },
          "instagramUrl": { "type": "object", "nullable": true, "example": null },
          "emailNotifications": { "type": "boolean", "example": true },
          "inAppNotifications": { "type": "boolean", "example": true }
        },
        "required": ["displayName", "locale", "emailNotifications", "inAppNotifications"]
      },
      "AuthUserResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "01a1d278-95d7-72ba-aff9-93927d0f23c7" },
          "email": { "type": "string", "example": "learner@example.com" },
          "emailVerified": { "type": "boolean", "example": true },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "SUSPENDED", "DELETED"],
            "example": "ACTIVE"
          },
          "roles": { "example": ["user"], "type": "array", "items": { "type": "string" } },
          "permissions": { "example": [], "type": "array", "items": { "type": "string" } },
          "profile": { "$ref": "#/components/schemas/AuthUserProfileResponseDto" }
        },
        "required": ["id", "email", "emailVerified", "status", "roles", "permissions", "profile"]
      },
      "AuthUserDataResponseDto": {
        "type": "object",
        "properties": { "user": { "$ref": "#/components/schemas/AuthUserResponseDto" } },
        "required": ["user"]
      },
      "AuthUserEnvelopeResponseDto": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/AuthUserDataResponseDto" },
          "meta": { "$ref": "#/components/schemas/ApiMetaResponseDto" }
        },
        "required": ["data", "meta"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "x-nestjs_zod-parent-additional-properties": false
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "x-nestjs_zod-parent-additional-properties": false
          }
        },
        "required": ["email", "password"]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "x-nestjs_zod-parent-additional-properties": false
          }
        },
        "required": ["email"]
      },
      "AcceptedResponseDto": {
        "type": "object",
        "properties": { "accepted": { "type": "boolean", "example": true } },
        "required": ["accepted"]
      },
      "AcceptedEnvelopeResponseDto": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/AcceptedResponseDto" },
          "meta": { "$ref": "#/components/schemas/ApiMetaResponseDto" }
        },
        "required": ["data", "meta"]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "x-nestjs_zod-parent-additional-properties": false
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "x-nestjs_zod-parent-additional-properties": false
          }
        },
        "required": ["token", "password"]
      },
      "ResetPasswordResponseDto": {
        "type": "object",
        "properties": { "reset": { "type": "boolean", "example": true } },
        "required": ["reset"]
      },
      "ResetPasswordEnvelopeResponseDto": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/ResetPasswordResponseDto" },
          "meta": { "$ref": "#/components/schemas/ApiMetaResponseDto" }
        },
        "required": ["data", "meta"]
      },
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "token": {
