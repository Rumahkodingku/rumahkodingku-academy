          },
          "503": {
            "description": "The Health Check is not successful\n\nService Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["error", "shutting_down"],
                      "example": "error"
                    },
                    "info": {
                      "type": "object",
                      "example": { "database": { "status": "up", "responseTime": 12 } },
                      "additionalProperties": {
                        "type": "object",
                        "required": ["status"],
                        "properties": {
                          "status": { "type": "string", "enum": ["up", "degraded", "down"] },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": ["status"],
                        "properties": {
                          "status": { "type": "string", "enum": ["up", "degraded", "down"] },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": { "status": "up", "responseTime": 12 },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": ["status"],
                        "properties": {
                          "status": { "type": "string", "enum": ["up", "degraded", "down"] },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Readiness check",
        "tags": ["Health"]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "example": "ok" } }
                }
              }
            }
          }
        },
        "summary": "Liveness check",
        "tags": ["Health"]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "description": "Creates the account, profile, and default learner role, then sends verification email.",
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RegisterDto" } }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthUserEnvelopeResponseDto" }
              }
            }
          },
          "400": { "description": "Bad Request" },
          "409": { "description": "Conflict" },
          "429": { "description": "Too Many Requests" }
        },
        "summary": "Register a learner account",
        "tags": ["Authentication"]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Verifies credentials and sets access and refresh cookies.",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginDto" } }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthUserEnvelopeResponseDto" }
              }
            }
          },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "429": { "description": "Too Many Requests" }
        },
        "summary": "Sign in",
        "tags": ["Authentication"]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "Rotates the refresh token and replaces the auth cookies.",
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthUserEnvelopeResponseDto" }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "429": { "description": "Too Many Requests" }
        },
        "summary": "Rotate the session",
        "tags": ["Authentication"]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Revokes the current refresh-token family and clears auth cookies.",
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": { "description": "Signed out" },
          "401": { "description": "Unauthorized" }
        },
        "security": [{ "access_token": [] }],
        "summary": "Sign out",
        "tags": ["Authentication"]
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "operationId": "AuthController_forgotPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
