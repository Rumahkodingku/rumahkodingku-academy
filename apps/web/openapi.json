{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/csrf/token": {
      "get": {
        "description": "Sets the CSRF session cookie and returns a token for the x-csrf-token header.",
        "operationId": "CsrfController_getToken",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CsrfTokenEnvelopeResponseDto" }
              }
            }
          },
          "500": { "description": "Internal Server Error" }
        },
        "summary": "Get a CSRF token",
        "tags": ["Security"]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful\n\nMySQL and Redis are available",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "info": { "type": "object" },
                    "error": { "type": "object" },
                    "details": { "type": "object" }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful\n\nService Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["error", "shutting_down"],
                      "example": "error"
                    },
                    "info": {
                      "type": "object",
                      "example": { "database": { "status": "up", "responseTime": 12 } },
                      "additionalProperties": {
                        "type": "object",
                        "required": ["status"],
                        "properties": {
                          "status": { "type": "string", "enum": ["up", "degraded", "down"] },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": ["status"],
                        "properties": {
                          "status": { "type": "string", "enum": ["up", "degraded", "down"] },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": { "status": "up", "responseTime": 12 },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": ["status"],
                        "properties": {
                          "status": { "type": "string", "enum": ["up", "degraded", "down"] },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Readiness check",
        "tags": ["Health"]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
