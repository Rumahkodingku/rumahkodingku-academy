{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@rumahkodingku-academy/*/src/*"],
            "message": "Use package entrypoints, not internal source paths."
          },
          {
            "group": ["apps/*", "../apps/*", "../../apps/*"],
            "message": "Apps must not import another app directly."
          }
        ]
      }
    ]
  },
  "env": {
    "builtin": true
  }
}
